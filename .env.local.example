# Apify integration (see src/lib/apify.ts)
# Required: your Apify API token (Settings -> Integrations in the Apify console).
APIFY_TOKEN=

# Provide ONE of the following:
# The actor that scrapes/produces your listings. The site fetches that actor's
# last successful run's dataset.
APIFY_ACTOR_ID=

# OR, if you'd rather pin to one specific dataset instead of "latest actor run":
APIFY_DATASET_ID=

# CRM database (Phase 2, see prisma/schema.prisma). SQLite — no external
# server needed. Swap to a postgresql:// URL later if you outgrow it.
DATABASE_URL="file:./prisma/dev.db"

# Admin dashboard auth (see src/lib/adminAuth.ts) — change these before deploying.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
# Random long string used to sign the admin session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=
