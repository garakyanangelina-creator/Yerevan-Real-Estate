// Phase 2 CRM storage. Uses SQLite so the project runs with zero external
// database setup; swap the datasource to postgresql + a real DATABASE_URL
// when a managed Postgres instance is provisioned (see README).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Property listings themselves are NOT stored here — they're fetched live
// from Apify on every request (see src/services/propertyService.ts). This
// model only tracks which property IDs we've already processed, so we can
// detect "newly imported" properties for matching/notifications.
model SeenProperty {
  id        String   @id // Apify/property id
  firstSeenAt DateTime @default(now())
}

model Client {
  id                 String    @id @default(cuid())
  fullName           String
  phone              String
  whatsapp           String?
  email              String?
  preferredLanguage  String // "en" | "ru" | "hy"
  propertyType       String // PropertyType
  purpose            String // "rent" | "sale"
  preferredDistricts String // JSON-encoded string[] of District
  minBudget          Float?
  maxBudget          Float?
  minArea            Float?
  maxArea            Float?
  bedrooms           Int?
  bathrooms          Int?
  furnished          String // "any" | "furnished" | "unfurnished"
  petsAllowed        Boolean   @default(false)
  parkingRequired    Boolean   @default(false)
  elevatorRequired   Boolean   @default(false)
  balconyRequired    Boolean   @default(false)
  notes              String?
  status             String    @default("active") // "active" | "paused" | "closed"
  archived           Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model Notification {
  id            String   @id @default(cuid())
  propertyId    String
  propertyTitle String
  matchCount    Int
  isRead        Boolean  @default(false)
  createdAt     DateTime @default(now())
}
