generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

// ── CRM ──────────────────────────────────────────────────────────────────────

model SeenProperty {
  id          String   @id
  firstSeenAt DateTime @default(now())
}

model Client {
  id                 String   @id @default(cuid())
  fullName           String
  phone              String
  whatsapp           String?
  email              String?
  preferredLanguage  String
  propertyType       String
  purpose            String
  preferredDistricts String
  minBudget          Float?
  maxBudget          Float?
  minArea            Float?
  maxArea            Float?
  bedrooms           Int?
  bathrooms          Int?
  furnished          String
  petsAllowed        Boolean  @default(false)
  parkingRequired    Boolean  @default(false)
  elevatorRequired   Boolean  @default(false)
  balconyRequired    Boolean  @default(false)
  notes              String?
  status             String   @default("active")
  archived           Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Notification {
  id            String   @id @default(cuid())
  propertyId    String
  propertyTitle String
  matchCount    Int
  isRead        Boolean  @default(false)
  createdAt     DateTime @default(now())
}

// ── Users & Access Control ────────────────────────────────────────────────────

model User {
  id           String       @id @default(cuid())
  username     String       @unique
  email        String?
  passwordHash String
  role         String       @default("employee") // super_admin | admin | employee
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  createdById  String?

  listings     DbProperty[]
}

// ── Employee Property Listings ────────────────────────────────────────────────

model DbProperty {
  id          String   @id @default(cuid())
  title       String
  description String?
  type        String   @default("apartment")
  purpose     String   @default("sale")
  district    String   @default("other")
  address     String?
  price       Float    @default(0)
  currency    String   @default("AMD")
  bedrooms    Int      @default(0)
  bathrooms   Int      @default(0)
  area        Float    @default(0)
  floor       Int      @default(0)
  totalFloors Int      @default(0)
  images      String   @default("[]") // JSON array of URL strings
  amenities   String   @default("{}") // JSON object
  status      String   @default("available") // available | sold | rented
  isPublished Boolean  @default(false)
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
}
